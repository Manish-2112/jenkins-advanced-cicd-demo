```groovy
// Import the custom Shared Library
@Library('my-shared-lib') _

pipeline {
    agent any

    environment {
        SONAR_HOST_URL = 'http://44.204.90.214:9000'
        SONAR_TOKEN    = credentials('sonar-token')
        NOTIFY_EMAIL   = 'testxyz0606@gmail.com'
    }

    stages {
        stage('1. Initialize & Audit') {
            steps {
                logStageBanner('INITIALIZE & ENVIRONMENT AUDIT')

                sh '''
                    echo "Running on Host: $(hostname)"
                    git --version
                    docker --version
                    ls -la
                '''
            }
        }

        stage('2. Unit Tests & Coverage') {
            agent {
                docker {
                    image 'python:3.11-slim'
                    reuseNode true
                }
            }

            steps {
                logStageBanner('RUNNING PYTEST UNIT TESTS & COVERAGE')

                dir('1-python-app-repo') {
                    runPythonUnitTests()
                }
            }

            post {
                always {
                    junit '1-python-app-repo/test-results.xml'
                }
            }
        }

        stage('3. SonarQube Code Quality Scan') {
            agent {
                docker {
                    image 'sonarsource/sonar-scanner-cli:latest'
                    reuseNode true
                }
            }

            steps {
                logStageBanner('RUNNING SONARQUBE STATIC CODE ANALYSIS')

                dir('1-python-app-repo') {
                    sh '''
                        export SONAR_USER_HOME="$WORKSPACE/.sonar"
                        mkdir -p "$SONAR_USER_HOME"

                        sonar-scanner \
                          -Dsonar.host.url=${SONAR_HOST_URL} \
                          -Dsonar.token=${SONAR_TOKEN}
                    '''
                }
            }
        }
    }

    post {
        success {
            sendBuildEmail('SUCCESS', env.NOTIFY_EMAIL)
        }

        failure {
            sendBuildEmail('FAILURE', env.NOTIFY_EMAIL)
        }
    }
}
```